# Environments & Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook & Interactive Environments
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.vscode/jupyter/

# Large Datasets & Raw Data (Do not push heavy data files to Git)
*.csv
*.tsv
*.xlsx
*.xls
*.xlsm
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite3
*.db
*.sql.dump

# Preserve directory structure via .gitkeep
!**/data/.gitkeep
!**/data/sample/*.csv

# Power BI binaries (Large binary files; prefer PBIP format or external storage)
*.pbix
*.pbit

# Environment variables & Secret Keys
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.yaml

# IDEs & System Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
*.swp
*.swo
*~
